{
  "Version": "2012-10-17",
  "Statement": {
    "Sid": "VpcEndpointOnly",
    "Effect": "Allow",
    "Principal": "*",
    "Action": "s3:GetObject",
    "Resource": "arn:aws:s3:::example-private-bucket/*",
    "Condition": {
      "StringEquals": { "aws:SourceVpce": "vpce-0123456789abcdef0" }
    }
  }
}
